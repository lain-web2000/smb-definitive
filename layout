MEMORY
{
	MAIN_ZP:	start =   $00, size =   $100;
	MAIN_RAM:	start = $0100, size =   $600;
	SOUND_ZP:	start =   $f0, size =    $0a;
	SOUND_RAM:	start = $0500, size =  $012b;
	
	INES:		start =     0, size =    $10, fill=yes, fillval=$00, type = rw;
	UNUSEDPRG:	start = $8000, size =  $C000, fill=yes, fillval=$FF, type = ro;
	SOUNDPRG:	start = $8000, size =  $4000, fill=yes, fillval=$FF, type = ro;
	LEVELPRG:  	start = $8000, size =  $4000, fill=yes, fillval=$FF, type = ro;
	LOADER:		start = $8000, size =  $4000, fill=yes, fillval=$FF, type = ro;
	SM2MAIN:	start = $8000, size =  $8000, fill=yes, fillval=$FF, type = ro;
	CHRROM:		start = $8000, size =  $4000, fill=yes, fillval=$FF, type = ro;
}

SEGMENTS
{
	MAIN_ZP:	load = MAIN_ZP, type = zp, define = yes;
	MAIN_RAM:	load = MAIN_RAM, type = bss, define = yes;
	SOUND_ZP:	load = SOUND_ZP, type = zp, define = yes;
	SOUND_RAM:	load = SOUND_RAM, type = bss, define = yes;

	INES:		load = INES, type = ro;
	UNUSEDPRG:	load = UNUSEDPRG, type = ro;
	SOUNDPRG:   load = SOUNDPRG, type = ro;
	LEVELPRG:   load = LEVELPRG, type = ro;
	LOADER:		load = LOADER,	type = ro;
	SM2MAIN:    load = SM2MAIN, type = ro;
	CHRROM:		load = CHRROM, 	type = ro;
}